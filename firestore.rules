rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function campaign(id) { return /databases/$(database)/documents/ecoCampaigns/$(id); }
    function invite(code) { return /databases/$(database)/documents/ecoInvites/$(code); }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /ecoCampaigns/{id} {
      function ownsCampaign() {
        return signedIn() && get(campaign(id)).data.ownerUid == request.auth.uid;
      }
      function isMember() {
        return signedIn() && exists(/databases/$(database)/documents/ecoCampaigns/$(id)/members/$(request.auth.uid));
      }
      function owner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
      function valid() {
        let d = request.resource.data;
        return signedIn() && d.ownerUid == request.auth.uid
          && id.matches(request.auth.uid + '_[a-zA-Z0-9_-]{1,80}')
          && d.keys().hasOnly(['name','description','systemId','maxPlayers','ownerUid','inviteCode'])
          && d.name is string && d.name.size() <= 120
          && d.description is string && d.description.size() <= 800
          && d.systemId is string && d.systemId.size() <= 80
          && d.maxPlayers is int && d.maxPlayers >= 1 && d.maxPlayers <= 12
          && d.inviteCode is string && d.inviteCode.matches('[0-9A-F]{24}')
          && getAfter(invite(d.inviteCode)).data.campaignId == id
          && getAfter(invite(d.inviteCode)).data.ownerUid == request.auth.uid;
      }
      allow get: if signedIn() && (id.matches(request.auth.uid + '_[a-zA-Z0-9_-]{1,80}') || owner() || exists(/databases/$(database)/documents/ecoCampaigns/$(id)/members/$(request.auth.uid)));
      allow create: if valid();
      allow update: if owner() && valid() && request.resource.data.inviteCode == resource.data.inviteCode;

      match /session/board {
        allow get: if ownsCampaign() || isMember();
        allow create, update: if ownsCampaign()
          && request.resource.data.keys().hasOnly(['board'])
          && request.resource.data.board is string
          && request.resource.data.board.size() <= 16000;
      }

      match /session/scene {
        allow get: if ownsCampaign() || isMember();
        allow create, update: if ownsCampaign()
          && request.resource.data.keys().hasOnly(['mode','image'])
          && request.resource.data.mode in ['combat','dialogue','rest']
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 560000;
      }

      match /session/combatView {
        allow get: if ownsCampaign() || isMember();
        allow create, update: if ownsCampaign()
          && request.resource.data.keys().hasOnly(['view'])
          && request.resource.data.view is string
          && request.resource.data.view.size() <= 22000;
      }

      match /combatInputs/{uid} {
        allow get, list: if ownsCampaign();
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.key is string && request.resource.data.key.size() <= 100
          && request.resource.data.value is int
          && ((request.resource.data.keys().hasOnly(['kind','key','value'])
               && ((request.resource.data.kind == 'initiative'
                && request.resource.data.value >= -500 && request.resource.data.value <= 500)
              || (request.resource.data.kind in ['pass','ack'] && request.resource.data.value == 0)
              || (request.resource.data.kind == 'reaction'
                && request.resource.data.value >= 0 && request.resource.data.value <= 32)))
              || (request.resource.data.kind == 'strike'
                && request.resource.data.keys().hasOnly(['kind','key','value','target','nonce'])
                && request.resource.data.value >= 0 && request.resource.data.value < 30
                && request.resource.data.target is string && request.resource.data.target.size() <= 100
                && request.resource.data.nonce is string && request.resource.data.nonce.matches('[a-f0-9-]{36}')));
      }

      match /sheets/{uid} {
        allow list: if ownsCampaign();
        allow get: if ownsCampaign() || (isMember() && request.auth.uid == uid);
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['sheet'])
          && request.resource.data.sheet is string
          && request.resource.data.sheet.size() <= 22000;
      }

      match /presence/{uid} {
        allow get, list: if ownsCampaign() || isMember();
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name','position','photo'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.position is int
          && request.resource.data.position >= 0 && request.resource.data.position <= 6
          && request.resource.data.photo is string && request.resource.data.photo.size() <= 240
          && (request.resource.data.photo == '' || request.resource.data.photo.matches('/?assets/[a-zA-Z0-9_./-]+'));
      }

      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['inviteCode'])
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.matches('[0-9A-F]{24}')
          && get(invite(request.resource.data.inviteCode)).data.campaignId == id
          && get(campaign(id)).data.inviteCode == request.resource.data.inviteCode;
      }
    }

    match /ecoInvites/{code} {
      function valid() {
        let d = request.resource.data;
        return signedIn() && code.matches('[0-9A-F]{24}')
          && d.keys().hasOnly(['ownerUid','campaignId'])
          && d.ownerUid == request.auth.uid && d.campaignId is string
          && getAfter(campaign(d.campaignId)).data.ownerUid == request.auth.uid
          && getAfter(campaign(d.campaignId)).data.inviteCode == code;
      }
      allow get: if signedIn();
      allow create: if valid();
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data == resource.data && valid();
    }
  }
}
